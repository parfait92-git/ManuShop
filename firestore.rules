rules_version = '2';

// See docs/04-besoins-techniques.md §6 for the rationale behind these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuration plateforme (ex. activer/désactiver /demo-catalogue) —
    // lecture publique (consultée par des visiteurs non connectés sur
    // /catalogue et /demo-catalogue), écriture interdite pour tout le
    // monde depuis le client : passe exclusivement par une Server Action
    // Super Admin (`configurationActions.ts`), même schéma que
    // `platformAdmins`.
    match /configuration/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Tags de catégorie système (BF-109→111) — lecture publique (un
    // commerçant en a besoin pour en choisir un en créant une catégorie),
    // écriture interdite pour tout le monde depuis le client : création/
    // suppression exclusivement via une Server Action Super Admin
    // (`categoryTagActions.ts`), même schéma que `configuration`.
    match /categoryTags/{tagId} {
      allow read: if true;
      allow write: if false;
    }

    // Produits — lecture publique, écriture admin/vendeur limitée à leur
    // propre boutique (shopId doit correspondre à celui de l'utilisateur).
    // Photo obligatoire (miroir de `ProductForm`) : au moins une à la
    // création, et impossible de retirer la dernière d'un produit qui en a.
    // `get('images', [])` : un ancien document sans ce champ ne doit pas
    // faire échouer l'évaluation (et donc bloquer toute mise à jour) — ces
    // anciens produits sans photo restent modifiables, signalés côté UI.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && request.resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId
        && (resource.data.get('images', []).size() == 0
          || request.resource.data.get('images', []).size() > 0);
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
    }

    // Catégories — lecture publique (utile pour filtrer la vitrine), même
    // règle d'écriture scopée par boutique que les produits.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && request.resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
    }

    // Journal d'activité commerçant (BF-98) — privé à la boutique
    // concernée, jamais public, contrairement à products/categories/shops.
    match /activityLog/{entryId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && request.resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Avis produit — lecture publique (fiche produit, BF-72), écriture
    // entièrement verrouillée : la soumission (BF-76) doit vérifier une
    // vraie commande livrée, appartenant à l'appelant, avant d'écrire —
    // passe uniquement par `firebase-admin` via
    // src/server/actions/reviewActions.ts (même schéma que `orders`).
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Avis du client sur la livraison d'une commande (2026-10-02) — privé :
    // lu par le client lui-même et par l'équipe (admin/seller) de la
    // boutique, jamais public. Écriture (avis, puis réponse du commerçant)
    // uniquement via src/server/actions/feedbackActions.ts.
    match /orderFeedback/{orderId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
            && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId));
      allow write: if false;
    }

    // Factures (BF-24→29, 2026-10-03) — figées à l'émission, émises par le
    // serveur seulement (src/server/invoices/issueInvoice.ts). Lues par le
    // client de la commande et par l'équipe de la boutique ; le PDF passe
    // par /api/factures/[orderId], qui revérifie ces mêmes droits.
    match /invoices/{orderId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
            && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId));
      allow write: if false;
    }

    // Historique signé des commandes (2026-10-03) : chaque étape chaînée à
    // la précédente et signée par le serveur (src/server/integrity/).
    // Écrit et lu par le serveur seulement ; la page publique de
    // vérification en montre ce qui peut l'être.
    match /orders/{orderId}/history/{eventId} {
      allow read, write: if false;
    }

    // Demandes d'achat d'articles premium (2026-10-03) : le gérant suit
    // celles de sa boutique ; création et décision par le serveur
    // (src/server/actions/premiumActions.ts).
    match /premiumRequests/{requestId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow write: if false;
    }

    // Compteurs de numérotation des factures : serveur seulement.
    match /invoiceCounters/{shopId} {
      allow read, write: if false;
    }

    // Notifications dans l'application (2026-10-02) — chacun lit les
    // siennes et peut seulement les marquer comme lues ; créées par le
    // serveur (`src/server/notifications.ts`).
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // Commandes (Module 4, BF-18→23/95→97) — double audience : le
    // commerçant (admin/seller de LA boutique de la commande) lit toutes
    // les commandes de sa boutique ; le client lit uniquement les siennes
    // (une commande manuelle, BF-21, n'a pas de `clientId` : invisible pour
    // tout client, seul le commerçant la voit). Écriture entièrement
    // verrouillée : création et changement de statut doivent rester
    // atomiques avec l'ajustement de stock associé (BF-96) et revalider
    // l'autorisation en code, donc passent uniquement par `firebase-admin`
    // via src/server/actions/orderActions.ts (même schéma que
    // `platformAdmins`/BF-68).
    // Prix d'achat des produits — à part de `products`, lisible par tout le
    // monde (vitrine publique) : un prix d'achat y serait visible de
    // n'importe quel visiteur ou concurrent. Réservé au gérant (role admin)
    // de la boutique ; les vendeurs n'y ont pas accès (choix de
    // l'utilisateur, 2026-10-02). Lu aussi par le serveur (`firebase-admin`,
    // hors règles) pour figer le coût de chaque vente.
    match /productCosts/{productId} {
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId
        && request.resource.data.purchasePrice is number
        && request.resource.data.purchasePrice >= 0
        && (resource == null
          || resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId);
    }

    // Coûts figés de chaque commande, écrits par le serveur à la création
    // (`createOrderAction`). À part de `orders`, que le client lit : il y
    // verrait sinon la marge du commerçant. Lecture réservée au gérant.
    match /orderCosts/{orderId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
            && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId));
      allow write: if false;
    }

    // Messages commerçant → Super Admin (BF-112→115) — même schéma que
    // `orders` : le commerçant (admin/seller de la boutique concernée) lit
    // ses propres messages (et leur réponse, une fois écrite, sur le même
    // document) ; écriture entièrement verrouillée, l'envoi (avec
    // vérification du privilège premium `contactForm`) et la réponse
    // doivent revalider en code, donc passent uniquement par
    // `firebase-admin` via src/server/actions/supportMessageActions.ts. Le
    // Super Admin lit tous les messages via une Server Action dédiée
    // (`listSupportMessagesAction`), pas via cette règle — non exprimable
    // ici sans dépendre de `platformAdmins` dans une règle, ce que le
    // projet évite délibérément (voir le bloc `platformAdmins` ci-dessous).
    match /supportMessages/{messageId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller']
        && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
      allow write: if false;
    }

    // Super Admin — PAS un rôle sur `users`, mais l'appartenance à cette
    // collection dédiée, indexée par email (Module 12, BF-67). Aucune
    // écriture autorisée depuis l'app, jamais, pour qui que ce soit :
    // uniquement une modification manuelle depuis la console Firebase par
    // l'éditeur de la plateforme lui-même. Voir src/models/platform/PlatformAdmin.ts.
    //
    // Depuis l'introduction de la couche serveur (src/server/auth/
    // requireSuperAdmin.ts), grantAdmin/revokeAdmin passent par
    // firebase-admin, qui CONTOURNE ces règles — elles ne sont donc plus la
    // seule vérification pour ce chemin précis, mais restent le seul rempart
    // contre tout autre chemin d'écriture (client direct, code pas encore
    // migré). Ne pas les assouplir pour autant.
    match /platformAdmins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // Utilisateurs — chacun gère son propre profil (sauf role/shopId, voir
    // update) ; l'auto-inscription crée toujours `role: 'client'`, jamais
    // 'admin' directement (BF-01 révisé — voir Module 12) ; un admin peut en
    // plus lire et créer les comptes Vendeur de sa propre boutique (gestion
    // d'équipe, BF-03) ; un Super Admin (voir `platformAdmins` ci-dessus)
    // peut lire tout le monde et changer le rôle de n'importe qui vers
    // admin/vendeur/client (BF-68) — jamais "super-admin", qui n'est pas une
    // valeur valide de `role` et n'existera donc jamais ici.
    match /users/{userId} {
      allow read: if request.auth.uid == userId
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          && resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId)
        || (request.auth != null
          && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.token.email)));

      allow create: if (request.auth.uid == userId && request.resource.data.role == 'client')
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          && request.resource.data.role == 'seller'
          && request.resource.data.shopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId);

      allow update: if (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          // `shopId` ne peut changer par auto-modification que si on est déjà
          // admin et que la boutique visée nous appartient réellement (cas :
          // AuthService.createShop() relie sa nouvelle boutique à son profil,
          // une fois le rôle admin obtenu par ailleurs — jamais à l'inscription).
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopId'])
              || (resource.data.role == 'admin'
                  && get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerId == request.auth.uid)))
        || (request.auth != null
          && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.token.email))
          && request.resource.data.role in ['admin', 'seller', 'client']);
    }

    // Shop — lecture publique ; création par un admin pour sa propre
    // boutique (ownerId doit être l'auteur) ; modification par le
    // propriétaire (admin de CETTE boutique, pas n'importe laquelle — trou
    // de sécurité corrigé lors du passage multi-boutique, Module 12) ou par
    // un Super Admin (modération).
    // Thème appliqué à une boutique (2026-10-03), rangé sous elle :
    // lisible par tous (la vitrine s'habille avec), écrit seulement par le
    // serveur (`applyShopThemeAction`, gérant de la boutique).
    match /shops/{shopId}/themes/{themeDoc} {
      allow read: if true;
      allow write: if false;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
              && resource.data.ownerId == request.auth.uid)
            || exists(/databases/$(database)/documents/platformAdmins/$(request.auth.token.email)));
    }
  }
}
