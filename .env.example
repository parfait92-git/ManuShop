# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (serveur uniquement — jamais NEXT_PUBLIC_*, contourne
# firestore.rules ; JSON du compte de service encodé en base64, voir
# docs/04-besoins-techniques.md §11.5)
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Émulateurs Firebase locaux (`npm run emulators`) — pour tester commandes,
# création de boutique, etc. sans compte de service ni API externes réelles
# (voir docs/04-besoins-techniques.md §17). Les 3 variables vont ensemble ;
# ne jamais les positionner en production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Signature numérique des factures et de l'historique des commandes
# (serveur uniquement — jamais NEXT_PUBLIC_*). Clé privée Ed25519, PKCS#8
# DER encodée en base64, à générer UNE fois :
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# À conserver précieusement : la perdre empêche de vérifier les signatures
# déjà émises. Absente : rien n'est signé (voir src/server/integrity/signing.ts).
INVOICE_SIGNING_KEY=MC4CAQAwBQYDK2VwBCIEIC19XFn7s5K+vb6cABEDFOmK42k/dmjY/fCzXJE5Bau2

# Cloudinary (stockage images/PDF)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# WhatsApp Business (Cloud API) — notification de nouvelle commande au
# commerçant (préférence Shop.notifyOrdersBySocial). WHATSAPP_ORDER_TEMPLATE_NAME
# doit correspondre à un template approuvé dans Meta Business Manager (variables
# {{1}} client, {{2}} n° commande, {{3}} montant, dans cet ordre) — sinon
# "new_order_notification" par défaut.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE_NAME=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Resend (emails)
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=

# Notifications push (2026-10-04) — Firebase console > Paramètres du projet >
# Cloud Messaging > Certificats Web Push > Générer une paire de clés.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Tâche planifiée Vercel (rappel de fin de promotion) : chaîne secrète
# quelconque ; Vercel l'envoie dans l'en-tête Authorization.
CRON_SECRET=
